generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model SysUser {
  id            Int       @id @default(autoincrement())
  username      String    @unique
  password      String
  realName      String?   @map("real_name")
  email         String?
  department    String?
  role          String    @default("USER")
  status        Int       @default(1)
  lastLoginTime DateTime? @map("last_login_time")
  createTime    DateTime  @default(now()) @map("create_time")
  updateTime    DateTime  @updatedAt @map("update_time")

  apiKeys      SysApiKey[]
  conversations Conversation[]
  dailyReports DailyReport[]

  @@map("sys_user")
}

model SysApiKey {
  id             Int      @id @default(autoincrement())
  userId         Int      @map("user_id")
  apiKey         String   @unique @map("api_key")
  keyPreview     String?  @map("key_preview")
  defaultModelId Int?     @map("default_model_id")
  status         Int      @default(1)
  createTime     DateTime @default(now()) @map("create_time")
  updateTime     DateTime @updatedAt @map("update_time")

  user SysUser @relation(fields: [userId], references: [id])

  @@map("sys_api_key")
}

model SysModel {
  id             Int      @id @default(autoincrement())
  name           String
  provider       String
  modelName      String   @map("model_name")
  baseUrl        String?  @map("base_url")
  apiKey         String?  @map("api_key")
  enabled        Int      @default(0)
  maxTokens      Int      @default(4096) @map("max_tokens")
  temperature    Float    @default(0.7)
  timeoutSeconds Int      @default(60) @map("timeout_seconds")
  isReviewModel  Int      @default(0) @map("is_review_model")
  createTime     DateTime @default(now()) @map("create_time")
  updateTime     DateTime @updatedAt @map("update_time")

  conversations Conversation[]
  promptReviews PromptReview[]

  @@map("sys_model")
}

model SysSetting {
  id           Int    @id @default(autoincrement())
  settingKey   String @unique @map("setting_key")
  settingValue String? @map("setting_value")
  description  String?

  @@map("sys_setting")
}

model Conversation {
  id           Int      @id @default(autoincrement())
  userId       Int      @map("user_id")
  modelId      Int?     @map("model_id")
  sessionId    String?  @map("session_id")
  title        String?
  summary      String?
  tokenCount   Int      @default(0) @map("token_count")
  messageCount Int      @default(0) @map("message_count")
  cost         Float    @default(0.0)
  createTime   DateTime @default(now()) @map("create_time")
  updateTime   DateTime @updatedAt @map("update_time")

  user     SysUser       @relation(fields: [userId], references: [id])
  model    SysModel?     @relation(fields: [modelId], references: [id])
  messages Message[]
  reviews  PromptReview[]

  @@map("conversation")
}

model Message {
  id             Int      @id @default(autoincrement())
  conversationId Int      @map("conversation_id")
  role           String
  content        String?
  tokens         Int      @default(0)
  promptTokens   Int?     @map("prompt_tokens")
  createTime     DateTime @default(now()) @map("create_time")

  conversation Conversation @relation(fields: [conversationId], references: [id])

  @@map("message")
}

model DailyReport {
  id            Int      @id @default(autoincrement())
  userId        Int      @map("user_id")
  reportDate    DateTime @map("report_date")
  summary       String?
  promptCount   Int      @default(0) @map("prompt_count")
  tokenCount    Int      @default(0) @map("token_count")
  score         Int?
  reviewContent String?  @map("review_content")
  createTime    DateTime @default(now()) @map("create_time")

  user SysUser @relation(fields: [userId], references: [id])

  @@map("daily_report")
}

model PromptReview {
  id             Int      @id @default(autoincrement())
  conversationId Int      @map("conversation_id")
  reviewModelId  Int?     @map("review_model_id")
  score          Int?
  strengths      String?
  weaknesses     String?
  suggestions    String?
  createTime     DateTime @default(now()) @map("create_time")

  conversation Conversation @relation(fields: [conversationId], references: [id])
  reviewModel  SysModel?   @relation(fields: [reviewModelId], references: [id])

  @@map("prompt_review")
}
