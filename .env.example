# 复制为 .env 后按需修改:cp .env.example .env
# ⚠️ 生产环境务必修改 JWT_SECRET 和 ADMIN_DEFAULT_PASSWORD

# 服务端口
PORT=8088

# SQLite 数据库路径(容器内路径;本地开发见 backend/.env)
DATABASE_URL=file:/app/data/app.db?connection_limit=1

# JWT 签名密钥 —— 生产环境必须替换为随机长字符串
# 生成示例:openssl rand -hex 32
JWT_SECRET=llm-api-proxy-dev-secret-change-me

# 登录有效期
JWT_EXPIRATION=24h

# 默认管理员账号 —— 首次登录后请立即修改密码
ADMIN_DEFAULT_USERNAME=admin
ADMIN_DEFAULT_PASSWORD=welcome123
